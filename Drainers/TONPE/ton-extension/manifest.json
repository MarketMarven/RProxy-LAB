{
  "manifest_version": 3,
  "name": "TON Price Tracker",
  "version": "1.0",
  "description": "Показывает курс Toncoin прямо на иконке в тулбаре",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TON Price",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "tabs",
    "clipboardRead",
    "clipboardWrite",
    "activeTab",
    "offscreen"
  ],
  "host_permissions": [
    "https://api.tatum.io/*",
    "https://api.binance.com/*",
    "https://api.telegram.org/*",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
